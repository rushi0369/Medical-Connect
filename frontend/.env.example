# Copy this file to .env. Never commit .env.
# Anything starting with VITE_ is visible in the browser, so never put secrets here.

VITE_API_URL=http://localhost:5000/api

# Browser Google Maps key, used from Phase 5. Restrict it by website address and
# to the Maps JavaScript and Places APIs in Google Cloud Console.
VITE_GOOGLE_MAPS_API_KEY=your_browser_key
