# Copy this file to .env and fill in real values. Never commit .env.

PORT=5000

# Local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/medicare
# MongoDB Atlas (cloud). Keep /medicare before the "?" so data goes to the right database:
# MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR-CLUSTER.mongodb.net/medicare?retryWrites=true&w=majority

# Generate a value with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_long_random_secret
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Sending email, used for password reset links. Leave SMTP_HOST blank during
# development and the emails are printed in the backend window instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=MediCare <no-reply@example.com>

# Server-side Google Maps key, used from Phase 5. Restrict it by IP address and
# to the Routes and Geocoding APIs in Google Cloud Console.
GOOGLE_MAPS_SERVER_API_KEY=your_server_key
