{
  "name": "medicare-backend",
  "version": "0.1.0",
  "description": "MediCare - Medical Store Order & Delivery Management System (REST API)",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
